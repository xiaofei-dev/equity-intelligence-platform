# Copy the relevant variables into a local .env file. Never commit real values.

# PostgreSQL
POSTGRES_DB=equity_intelligence
POSTGRES_USER=equity_app
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/equity_intelligence
SPRING_DATASOURCE_USERNAME=equity_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-secret
ANALYTICS_BASE_URL=http://localhost:8000

# Analytics service providers
OPENAI_API_KEY=
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=
ANALYTICS_DATABASE_URL=postgresql://equity_app:replace-with-a-local-secret@localhost:5432/equity_intelligence

# Frontend: only variables intended for browser exposure may use NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
