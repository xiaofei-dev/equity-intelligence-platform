# Copy the relevant variables into a local .env file. Never commit real values.

# PostgreSQL
POSTGRES_DB=equity_intelligence
POSTGRES_USER=equity_app
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/equity_intelligence
SPRING_DATASOURCE_USERNAME=equity_app
SPRING_DATASOURCE_PASSWORD=replace-with-a-local-secret
ANALYTICS_BASE_URL=http://localhost:8000

# Analytics service providers
OPENAI_API_KEY=
MARKET_DATA_PROVIDER=yfinance
TWELVE_DATA_API_KEY=
EODHD_API_KEY=
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=20
MARKET_DATA_MAX_RETRIES=2
# SEC requires a descriptive application name and a real contact address.
SEC_USER_AGENT=
ANALYTICS_DATABASE_URL=postgresql://equity_app:replace-with-a-local-secret@localhost:5432/equity_intelligence

# Frontend: only variables intended for browser exposure may use NEXT_PUBLIC_.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_BASE_URL=http://localhost:8080
#
# Server-only research workspace configuration. The snapshot ID is produced by
# the sealed snapshot workflow; do not invent or reuse an unsealed identifier.
#
CLOSED_TEST_IDENTITY=
RESEARCH_DATA_SNAPSHOT_ID=
RESEARCH_SNAPSHOT_AS_OF=
RESEARCH_SCREENING_RUN_ID=
#
# Closed-test identity resolution is disabled by default. Enable it only in a
# trusted local or closed-test environment after provisioning LOCAL_TEST
# identities in app.authentication_identity.
#
CLOSED_TEST_IDENTITY_ENABLED=false
CLOSED_TEST_IDENTITY_ISSUER=equity-local
